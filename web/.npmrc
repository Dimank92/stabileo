# svelte-check (latest, 4.7.7) declares peer typescript "^5.0.0 || ^6.0.0" and
# cannot run against TypeScript 7, which no longer ships the classic JS compiler
# API — svelte-check's own TS7 path expects typescript@~6 under the `typescript`
# name plus TS7 under the `@typescript/native` alias. This project keeps
# `typescript` at 7 for the tsc gate, so the peer range is unsatisfiable and
# plain installs fail with ERESOLVE. Peer auto-install is off here; every
# package the tooling needs at runtime is declared explicitly in package.json.
# svelte-check gets its supported compiler through the `typescript6` alias —
# see scripts/ensure-svelte-check-ts6.mjs.
legacy-peer-deps=true
