# Installed as /etc/caddy/stabileo.env by infra/cloud-init/staging.yaml. Caddy reads these as
# {$NAME} placeholders in infra/caddy/Caddyfile; `caddy validate --envfile` reads the same file.
APP_DOMAIN=staging.stabileo.com
ADMIN_DOMAIN=admin.staging.stabileo.com
STABILEO_ROOT=/srv/stabileo
BACKEND_PORT=4100
